{
  "name": "HA Custom Integration Dev",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.6": {
      "configureZshAsDefaultShell": true
    }
  },
  "forwardPorts": [
    8123
  ],
  "postCreateCommand": "pip3 install homeassistant && mkdir -p config",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "keesschollaart.vscode-home-assistant"
      ]
    }
  }
}
